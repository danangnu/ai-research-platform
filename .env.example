# Database
POSTGRES_DB=ai_research
POSTGRES_USER=research
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://research:change-this-postgres-password@db:5432/ai_research

# API
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Seed administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Project Administrator

# Optional demo-only participant used for RBAC acceptance testing.
# Seeded only when DEMO_MODE=true and both email/password are set.
DEMO_PARTICIPANT_EMAIL=
DEMO_PARTICIPANT_PASSWORD=
DEMO_PARTICIPANT_FULL_NAME=Demo Participant

# Frontend
VITE_API_URL=http://localhost:8000

# Deployment mode
DEMO_MODE=false
VITE_DEMO_MODE=false

# Step 1B recruitment demo
RECRUITMENT_OPEN=true
SCREENING_CONSENT_VERSION=DEMO-STEP1B-v1
